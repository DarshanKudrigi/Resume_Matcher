# ==========================================
# ResumeMate - FastAPI & PostgreSQL Configuration
# ==========================================

# Application Settings
PROJECT_NAME="ResumeMate API"
VERSION="1.0.0"
API_PREFIX="/api"
PORT=8000
HOST="127.0.0.1"

# Security / JWT
SECRET_KEY="resumemate-super-secret-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# PostgreSQL Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=resume_analyzer_db

# Async Database URL for SQLAlchemy + asyncpg
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/resume_analyzer_db

# Fallback Database (used if PostgreSQL connection is unreachable or password not yet set)
FALLBACK_TO_SQLITE=True

# Optional: Google Gemini API Key for deep LLM resume analysis & chatbot
# If empty, built-in intelligent NLP & ATS rules engine is used seamlessly
GEMINI_API_KEY=""
